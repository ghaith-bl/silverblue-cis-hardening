// browsevm (docs/browsevm.md): the daily user may start / stop browsevm.service from
// a local, active session. Nothing else: no other unit, no other verb (restart, enable,
// ...), no libvirt access (the libvirt group = root).
// "browsevm.sh install" writes this to /etc/polkit-1/rules.d with @USER@ filled in.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "browsevm.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        subject.user == "@USER@" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
