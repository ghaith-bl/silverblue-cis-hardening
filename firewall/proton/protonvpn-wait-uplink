#!/bin/sh
# protonvpn-wait-uplink - ExecStartPre of protonvpn-connect.service (user unit).
# Exits 0 once a wifi or ethernet device is connected (NetworkManager). Until then no
# connect attempt: offline, `protonvpn connect` failed every 15 s (Restart=) and each
# try left lines in the journal (2026-10-20 cold boot, 2026-10-25).
#
# The wait is event-driven: nm-online(1) returns when NetworkManager reports an active
# connection (exit 0), else after -t seconds (exit 1). An active connection can also be
# the Proton kill switch dummy (default route), so the device state decides and
# nm-online only waits. Quiet: one line when the wait starts, one when it ends.

uplink() {
    /usr/bin/nmcli -t -f TYPE,STATE device 2>/dev/null \
        | grep -qE '^(wifi|ethernet):connected$'
}

uplink && exit 0
echo "no wifi / ethernet connected: waiting, no connect attempt until then"
until uplink; do
    /usr/bin/nm-online -q -t 60
    uplink || sleep 10        # online via another device, or nm-online error: wait here
done
echo "wifi / ethernet connected: connecting"
