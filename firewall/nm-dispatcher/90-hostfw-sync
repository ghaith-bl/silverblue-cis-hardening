#!/bin/sh
# NetworkManager dispatcher: keep hostfw sets in sync
# (router after a network change; wg_fwmark too while the tunnel is up)
# installed to /etc/NetworkManager/dispatcher.d/ by: hostfw install

case "$2" in
        up|down|vpn-up|vpn-down|dhcp4-change|reapply) ;;
    *) exit 0 ;;
esac

[ -x /usr/local/sbin/hostfw ] || exit 0
/usr/sbin/nft list table inet hostfw >/dev/null 2>&1 || exit 0

/usr/local/sbin/hostfw sync 2>&1 | logger -t hostfw-dispatcher -p daemon.info
exit 0
